# Supabase — usar las keys NUEVAS (no las viejas anon / service_role)
# Sacalas de tu proyecto en supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# TMDB — https://www.themoviedb.org/settings/api (pedir "API Read Access Token" o "API Key v3")
TMDB_API_KEY=

# OMDb — https://www.omdbapi.com/apikey.aspx (free tier: 1000 requests/día)
OMDB_API_KEY=
